{
  "name": "tipsy",
  "version": "2.2.0",
  "private": true,
  "description": "A simple tip calculator and bill divider PWA",
  "bugs": {
    "url": "https://github.com/wKovacs64/tipsy/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wKovacs64/tipsy.git"
  },
  "type": "module",
  "imports": {
    "#/*": "./*"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "preview": "vite --host 127.0.0.1 preview",
    "test": "pnpm run test:e2e:open",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:run": "cross-env CI=true playwright test",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@fontsource/source-sans-3": "5.3.0",
    "clsx": "2.1.1",
    "currency.js": "2.0.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "tailwindcss": "4.3.3",
    "use-local-storage-state": "20.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@playwright/test": "1.62.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tailwindcss/vite": "4.3.3",
    "@types/fs-extra": "11.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@wkovacs64/add-icon": "1.2.2",
    "@wkovacs64/eslint-config": "8.0.3",
    "@wkovacs64/oxlint-config": "0.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "fs-extra": "11.4.0",
    "git-current-commit": "1.1.0",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "type-fest": "5.8.0",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-icons-spritesheet": "3.1.0",
    "vite-plugin-pwa": "1.3.0",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "packageManager": "pnpm@11.21.0"
}
