{
  "name": "tipsy",
  "version": "3.0.1",
  "private": true,
  "description": "A simple tip calculator and bill divider PWA",
  "bugs": {
    "url": "https://github.com/wKovacs64/tipsy/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Justin Hall",
    "email": "justin.r.hall@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wKovacs64/tipsy.git"
  },
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint",
    "preview": "vite --host 127.0.0.1 preview",
    "test": "vitest",
    "test:e2e:open": "playwright test --ui",
    "test:e2e:run": "cross-env CI=true playwright test",
    "test:unit": "vitest run",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@fontsource/bagel-fat-one": "5.3.0",
    "@fontsource/figtree": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "use-local-storage-state": "20.0.0"
  },
  "devDependencies": {
    "@babel/core": "8.1.3",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@playwright/test": "1.65.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@wkovacs64/oxlint-config": "0.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "git-current-commit": "1.1.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-build": "7.4.1",
    "workbox-window": "7.4.1"
  },
  "packageManager": "pnpm@12.21.0"
}
